{
  "schema_version": "1.0",
  "connector": {
    "name": "utm-operations-connector",
    "role": "local_utm_adapter"
  },
  "operator_console": {
    "path": "/ui/",
    "launch_url": "/ui/",
    "entrypoint": "browser"
  },
  "api": {
    "prefix": "/v1",
    "discovery_path": "/v1/integration",
    "capabilities_path": "/v1/capabilities",
    "health_path": "/v1/health",
    "version_path": "/v1/version",
    "metrics_path": "/v1/metrics",
    "vehicles_path": "/v1/vehicles",
    "telemetry_path": "/v1/vehicles/{vehicle_id}",
    "vehicle_status_path": "/v1/vehicles/{vehicle_id}/status",
    "mission": {
      "canonical": {
        "method": "PUT",
        "path": "/v1/missions/{vehicle_id}"
      },
      "qgroundcontrol": {
        "method": "PUT",
        "path": "/v1/missions/{vehicle_id}/qgroundcontrol"
      },
      "mission_planner": {
        "method": "PUT",
        "path": "/v1/missions/{vehicle_id}/mission-planner"
      },
      "onboard": {
        "method": "GET",
        "path": "/v1/vehicles/{vehicle_id}/onboard-mission"
      },
      "onboard_refresh": {
        "method": "POST",
        "path": "/v1/vehicles/{vehicle_id}/onboard-mission/refresh"
      },
      "onboard_raw": {
        "method": "GET",
        "path": "/v1/vehicles/{vehicle_id}/onboard-mission/raw"
      },
      "onboard_import": {
        "method": "POST",
        "path": "/v1/vehicles/{vehicle_id}/onboard-mission/import"
      }
    },
    "operations": {
      "intent": {
        "method": "POST",
        "path": "/v1/operator-intents?vehicle_id={vehicle_id}"
      },
      "get": {
        "method": "GET",
        "path": "/v1/operations/{operation_id}"
      },
      "refresh": {
        "method": "POST",
        "path": "/v1/operations/{operation_id}/refresh"
      }
    }
  },
  "mission_formats": [
    "canonical",
    "qgroundcontrol",
    "mission-planner"
  ],
  "supported_gcs": [
    {
      "id": "qgroundcontrol",
      "name": "QGroundControl",
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "mission_formats": [
        ".plan"
      ],
      "integration_modes": [
        "browser_console",
        "optional_native_fly_view_overlay"
      ]
    },
    {
      "id": "mission-planner",
      "name": "Mission Planner",
      "platforms": [
        "windows"
      ],
      "mission_formats": [
        ".waypoints"
      ],
      "integration_modes": [
        "browser_console",
        "optional_menu_plugin"
      ],
      "validated_source_version": "1.3.83"
    }
  ],
  "mission_commands": [
    {
      "command": 16,
      "name": "WAYPOINT",
      "role": "route_point"
    },
    {
      "command": 21,
      "name": "LAND",
      "role": "route_endpoint"
    },
    {
      "command": 22,
      "name": "TAKEOFF",
      "role": "route_point"
    }
  ],
  "ignored_terminal_mission_commands": [
    {
      "command": 20,
      "name": "RETURN_TO_LAUNCH",
      "role": "terminal_behavior_ignored"
    }
  ],
  "recording": {
    "configuration": "UTM_CONNECTOR_RECORD_PATH",
    "raw_mavlink_record_type": "mavlink_frame",
    "replay": "JsonlReplay.replay_mavlink"
  },
  "mavlink": {
    "vehicle_control": "none",
    "mission_download": true,
    "recommended_topology": "single_router_endpoint",
    "connector_input_uri": "udpin:127.0.0.1:14551"
  }
}
