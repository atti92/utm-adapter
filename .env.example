# The local API binds to loopback by default.
UTM_CONNECTOR_HOST=127.0.0.1
UTM_CONNECTOR_PORT=8000
UTM_CONNECTOR_LOG_LEVEL=info
# Use :memory: for a disposable run; SQLite keeps local state across restarts.
UTM_CONNECTOR_STATE_DB_PATH=connector-state.sqlite3
# Only this many recent events are loaded into API memory; SQLite keeps the full audit history.
UTM_CONNECTOR_EVENT_HISTORY_LIMIT=1000
# Set a JSONL path such as connector-events.jsonl to record connector events,
# provider exchanges, and raw inbound MAVLink frames for deterministic replay.
UTM_CONNECTOR_RECORD_PATH=
UTM_CONNECTOR_BACKEND=in-memory
UTM_CONNECTOR_FLIGHT_BLENDER_BASE_URL=http://127.0.0.1:8989
# Flight Blender's local bypass still expects a JWT with iss, aud, and scope claims.
UTM_CONNECTOR_FLIGHT_BLENDER_BEARER_TOKEN=
UTM_CONNECTOR_FLIGHT_BLENDER_TIMEOUT_S=10
UTM_CONNECTOR_FLIGHT_BLENDER_MAX_RETRIES=3
UTM_CONNECTOR_FLIGHT_BLENDER_RETRY_BACKOFF_S=0.25
UTM_CONNECTOR_FLIGHT_BLENDER_TYPE_OF_OPERATION=1
UTM_CONNECTOR_FLIGHT_BLENDER_SUBMITTED_BY=connector@example.invalid
UTM_CONNECTOR_FLIGHT_BLENDER_ORIGINATING_PARTY=utm-operations-connector
# Required when the provider needs WGS84 heights but MAVLink supplies AMSL.
# Use an EGM96/EGM2008 PROJ grid supplied by the host installation.
UTM_CONNECTOR_ALTITUDE_GEOID_GRID_PATH=
# Opt-in self-contained console demo; keep false for normal GCS operation.
UTM_CONNECTOR_DEMO_MODE=false
UTM_CONNECTOR_DEMO_VEHICLE_ID=demo-sitl
UTM_CONNECTOR_DEMO_INTERVAL_S=1.0
# JSON list. Leave empty to run without a live MAVLink session.
UTM_CONNECTOR_MAVLINK_CONNECTIONS=[]
UTM_CONNECTOR_MAVLINK_POLL_INTERVAL_S=0.2
